# Copy to .env and fill in the values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/url_shortner"
JWT_SECRET="change-me-to-at-least-16-characters"
PORT=3000
NODE_ENV=development

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Kafka (docker compose sets KAFKA_BROKERS=kafka:29092 for the app container)
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="url-shortner"
KAFKA_GROUP_ID="url-shortner-clicks"
